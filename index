/* ==========================================================================
   13. MARKET ANALYSIS SVG CHART
   ========================================================================== */
function generateSeries(n, volatility){
  let v = 150 + Math.random() * 40;
  const arr = [];
  for (let i = 0; i < n; i++){
    v += (Math.random() - 0.5) * volatility;
    v = Math.max(40, Math.min(300, v));
    arr.push(v);
  }
  return arr;
}
function drawAnalysisChart(){
  const svg = document.getElementById('analysis-svg');
  const w = 1000, h = 340;
  const series = generateSeries(50, 14);
  const max = Math.max(...series), min = Math.min(...series);
  const pts = series.map((v, i) => {
    const x = (i / (series.length - 1)) * w;
    const y = h - ((v - min) / (max - min || 1)) * (h - 40) - 20;
    return [x, y];
  });
  const linePath = pts.map((p, i) => (i === 0 ? 'M' : 'L') + p[0].toFixed(1) + ',' + p[1].toFixed(1)).join(' ');
  const areaPath = linePath + ` L${w},${h} L0,${h} Z`;

  let gridLines = '';
  for (let i = 0; i <= 4; i++){
    const y = (h / 4) * i;
    gridLines += `<line x1="0" y1="${y}" x2="${w}" y2="${y}" stroke="rgba(181,194,212,.08)" stroke-width="1"/>`;
  }

  const dotIndex = pts.length - 1;
  svg.innerHTML = `
    <defs>
      <linearGradient id="areaGrad" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#00E676" stop-opacity=".35"/>
        <stop offset="100%" stop-color="#00E676" stop-opacity="0"/>
      </linearGradient>
    </defs>
    ${gridLines}
    <path class="chart-area" d="${areaPath}" fill="url(#areaGrad)"/>
    <path class="chart-path" d="${linePath}"/>
    <circle class="chart-dot" cx="${pts[dotIndex][0]}" cy="${pts[dotIndex][1]}" r="5"/>
  `;
}
drawAnalysisChart();

