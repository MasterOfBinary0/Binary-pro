   14. CTA BANNER
   ========================================================================== */
.cta-banner{ padding:80px; border-radius:var(--radius-lg); text-align:center; position:relative; overflow:hidden; }
.cta-banner h2{ margin-top:0; }
.cta-banner p{ color:var(--sub); max-width:560px; margin:18px auto 34px; }
.cta-glow{ position:absolute; width:500px; height:500px; border-radius:50%; background:radial-gradient(circle, var(--primary-glow), transparent 70%); top:-200px; left:50%; transform:translateX(-50%); pointer-events:none; }

