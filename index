<script>
/* ==========================================================================
   9. ANIMATED CANDLESTICK CHART (hero dashboard)
   ========================================================================== */
const candleCanvas = document.getElementById('candles-canvas');
const cctx = candleCanvas.getContext('2d');
let candles = [];
let basePrice = 1.08452;

function seedCandles(){
  candles = [];
  let p = basePrice;
  for (let i = 0; i < 40; i++){
    const open = p;
    const change = (Math.random() - 0.48) * 0.0016;
    const close = open + change;
    const high = Math.max(open, close) + Math.random() * 0.0009;
    const low = Math.min(open, close) - Math.random() * 0.0009;
    candles.push({ open, close, high, low });
    p = close;
  }
}
seedCandles();

function resizeCandleCanvas(){
  const rect = candleCanvas.parentElement.getBoundingClientRect();
  candleCanvas.width = rect.width * devicePixelRatio;
  candleCanvas.height = rect.height * devicePixelRatio;
  candleCanvas.style.width = rect.width + 'px';
  candleCanvas.style.height = rect.height + 'px';
  cctx.setTransform(devicePixelRatio, 0, 0, devicePixelRatio, 0, 0);
}

function drawCandles(){
  const rect = candleCanvas.parentElement.getBoundingClientRect();
  const w = rect.width, h = rect.height;
  cctx.clearRect(0, 0, w, h);

  const prices = candles.flatMap(c => [c.high, c.low]);
  const max = Math.max(...prices), min = Math.min(...prices);
  const pad = (max - min) * 0.15 || 0.001;
  const yMax = max + pad, yMin = min - pad;

  const slot = w / candles.length;
  const bodyW = Math.max(slot * 0.45, 2);

  candles.forEach((c, i) => {
    const x = i * slot + slot / 2;
    const yOpen = h - ((c.open - yMin) / (yMax - yMin)) * h;
    const yClose = h - ((c.close - yMin) / (yMax - yMin)) * h;
    const yHigh = h - ((c.high - yMin) / (yMax - yMin)) * h;
    const yLow = h - ((c.low - yMin) / (yMax - yMin)) * h;
    const bullish = c.close >= c.open;
    const color = bullish ? '#00E676' : '#FF4D6D';

    cctx.strokeStyle = color;
    cctx.lineWidth = 1.2;
    cctx.beginPath();
    cctx.moveTo(x, yHigh);
    cctx.lineTo(x, yLow);
    cctx.stroke();

    cctx.fillStyle = color;
    const top = Math.min(yOpen, yClose);
    const bh = Math.max(Math.abs(yClose - yOpen), 1.5);
    cctx.fillRect(x - bodyW/2, top, bodyW, bh);
  });
}

function tickCandles(){
  candles.shift();
  const last = candles[candles.length - 1];
  const open = last.close;
  const change = (Math.random() - 0.48) * 0.0016;
  const close = open + change;
  const high = Math.max(open, close) + Math.random() * 0.0009;
  const low = Math.min(open, close) - Math.random() * 0.0009;
  candles.push({ open, close, high, low });

  const priceEl = document.getElementById('livePrice');
  const changeEl = document.getElementById('liveChange');
  if (priceEl){
    priceEl.textContent = close.toFixed(5);
    const pct = ((close - basePrice) / basePrice * 100);
    changeEl.textContent = (pct >= 0 ? '+' : '') + pct.toFixed(2) + '%';
    changeEl.style.color = pct >= 0 ? 'var(--primary)' : 'var(--danger)';
  }
  drawCandles();
}

resizeCandleCanvas();
drawCandles();
setInterval(tickCandles, 1400);
window.addEventListener('resize', () => { resizeCandleCanvas(); drawCandles(); });

/* ==========================================================================
   10. PARTICLE SYSTEM (background)
   ========================================================================== */
const pCanvas = document.getElementById('particles-canvas');
const pctx = pCanvas.getContext('2d');
let particles = [];

function resizeParticleCanvas(){
  pCanvas.width = window.innerWidth;
  pCanvas.height = window.innerHeight;
}
resizeParticleCanvas();
window.addEventListener('resize', resizeParticleCanvas);

const colors = ['#00E676', '#00C2FF', '#9C6BFF'];
function initParticles(){
  particles = [];
  const count = Math.min(70, Math.floor(window.innerWidth / 22));
  for (let i = 0; i < count; i++){
    particles.push({
      x: Math.random() * pCanvas.width,
      y: Math.random() * pCanvas.height,
      r: Math.random() * 1.6 + .6,
      vx: (Math.random() - .5) * .25,
      vy: (Math.random() - .5) * .25,
      c: colors[Math.floor(Math.random() * colors.length)],
      a: Math.random() * .5 + .2
    });
  }
}
initParticles();

function drawParticles(){
  pctx.clearRect(0, 0, pCanvas.width, pCanvas.height);
  particles.forEach(p => {
    p.x += p.vx; p.y += p.vy;
    if (p.x < 0) p.x = pCanvas.width; if (p.x > pCanvas.width) p.x = 0;
    if (p.y < 0) p.y = pCanvas.height; if (p.y > pCanvas.height) p.y = 0;
    pctx.beginPath();
    pctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
    pctx.fillStyle = p.c;
    pctx.globalAlpha = p.a;
    pctx.fill();
  });
  pctx.globalAlpha = 1;
  requestAnimationFrame(drawParticles);
}
drawParticles();
</script>

