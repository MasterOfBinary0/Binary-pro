.test-card{ padding:28px; border-radius:var(--radius-md); }
.test-stars{ color:var(--secondary); margin-bottom:16px; letter-spacing:3px; }
.test-card p{ color:var(--sub); font-size:.94rem; margin-bottom:22px; }
