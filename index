      <path d="${areaPath}" fill="rgba(0,194,255,.15)"/>
      <path d="${linePath}" fill="none" stroke="#00C2FF" stroke-width="2" stroke-linecap="round"/>
    `;
  });
}
drawMiniCharts();
</script>
