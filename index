<style>
:root{
  --bg-0:#050816;
  --bg-1:#081221;
  --bg-2:#0D1728;
  --primary:#00E676;
  --secondary:#00C2FF;
  --accent:#9C6BFF;
  --danger:#FF4D6D;
  --text:#FFFFFF;
  --sub:#B5C2D4;

  --primary-glow: rgba(0,230,118,.35);
  --secondary-glow: rgba(0,194,255,.30);
  --accent-glow: rgba(156,107,255,.30);

  --glass-bg: rgba(255,255,255,.04);
  --glass-border: rgba(255,255,255,.08);
  --glass-hi: rgba(255,255,255,.12);

  --font-display:'Space Grotesk', sans-serif;
  --font-body:'Inter', sans-serif;
  --font-ui:'Poppins', sans-serif;

  --radius-sm:10px;
  --radius-md:18px;
  --radius-lg:28px;

  --ease-out: cubic-bezier(.16,1,.3,1);
  --ease-in-out: cubic-bezier(.65,0,.35,1);
}

*,*::before,*::after{ box-sizing:border-box; margin:0; padding:0; }
html{ scroll-behavior:smooth; }
body{
  background: var(--bg-0);
  color:var(--text);
  font-family: var(--font-body);
  overflow-x:hidden;
  line-height:1.6;
  -webkit-font-smoothing:antialiased;
}
img{max-width:100%; display:block;}
a{color:inherit; text-decoration:none;}
ul{list-style:none;}
button{font-family:inherit; cursor:pointer; border:none; background:none; color:inherit;}
.container{ width:min(1240px, 92%); margin:0 auto; }
::selection{ background:var(--primary); color:#03170D; }

@media (prefers-reduced-motion: reduce){
  *{ animation-duration:.01ms !important; animation-iteration-count:1 !important; transition-duration:.01ms !important; scroll-behavior:auto !important; }
}

::-webkit-scrollbar{ width:8px; }
::-webkit-scrollbar-track{ background:var(--bg-0); }
::-webkit-scrollbar-thumb{ background:linear-gradient(var(--primary), var(--secondary)); border-radius:10px; }

.bg-fixed{
  position:fixed; inset:0; z-index:-3; background:
    radial-gradient(1200px 700px at 15% -10%, rgba(0,230,118,.10), transparent 60%),
    radial-gradient(1000px 600px at 90% 10%, rgba(0,194,255,.10), transparent 60%),
    radial-gradient(900px 700px at 50% 110%, rgba(156,107,255,.10), transparent 60%),
    linear-gradient(180deg, var(--bg-0), var(--bg-1) 40%, var(--bg-0));
}

.grid-overlay{
  position:fixed; inset:0; z-index:-2; opacity:.35;
  background-image:
    linear-gradient(rgba(181,194,212,.06) 1px, transparent 1px),
    linear-gradient(90deg, rgba(181,194,212,.06) 1px, transparent 1px);
  background-size: 42px 42px;
  animation: gridDrift 40s linear infinite;
  mask-image: radial-gradient(circle at 50% 20%, black, transparent 75%);
}
@keyframes gridDrift{ 0%{background-position:0 0,0 0;} 100%{background-position:42px 84px, 84px 42px;} }

#particles-canvas{ position:fixed; inset:0; z-index:-1; pointer-events:none; }

.mouse-glow{
  position:fixed; top:0; left:0; width:520px; height:520px; border-radius:50%;
  background: radial-gradient(circle, var(--primary-glow), transparent 65%);
  pointer-events:none; z-index:0; transform:translate(-50%,-50%);
  filter:blur(10px); transition: opacity .3s ease; opacity:0;
}

.aurora{ position:fixed; inset:0; z-index:-2; overflow:hidden; pointer-events:none; }
.aurora span{
  position:absolute; width:60vw; height:60vw; border-radius:50%; filter:blur(90px); opacity:.18;
  animation: auroraFloat 22s var(--ease-in-out) infinite;
}
.aurora span:nth-child(1){ background:var(--primary); top:-20%; left:-10%; }
.aurora span:nth-child(2){ background:var(--secondary); top:10%; right:-15%; animation-delay:-7s; }
.aurora span:nth-child(3){ background:var(--accent); bottom:-25%; left:30%; animation-delay:-14s; }
@keyframes auroraFloat{
  0%,100%{ transform: translate(0,0) scale(1); }
  33%{ transform: translate(6%, 8%) scale(1.1); }
  66%{ transform: translate(-8%, -4%) scale(.95); }
}

/* ==========================================================================
   2. NAVBAR
   ========================================================================== */
.navbar{
  position:fixed; top:0; left:0; right:0; z-index:100;
  padding:20px 0;
  transition: padding .35s var(--ease-out), background .35s var(--ease-out), border-color .35s var(--ease-out);
  border-bottom:1px solid transparent;
}
.navbar.scrolled{
  padding:12px 0;
  background:rgba(5,8,22,.75);
  backdrop-filter: blur(16px) saturate(140%);
  -webkit-backdrop-filter: blur(16px) saturate(140%);
  border-bottom:1px solid var(--glass-border);
}
.navbar .container{ display:flex; align-items:center; justify-content:space-between; }
.brand{ display:flex; align-items:center; gap:10px; font-family:var(--font-display); font-weight:700; font-size:1.25rem; letter-spacing:.2px; }
.brand-mark{
  width:38px; height:38px; border-radius:11px; position:relative;
  background: linear-gradient(145deg, var(--bg-2), var(--bg-1));
  border:1px solid var(--glass-border);
  display:flex; align-items:center; justify-content:center;
  box-shadow: 0 0 0 1px rgba(255,255,255,.02) inset, 0 8px 24px -8px var(--primary-glow);
}
.brand-mark svg{ width:20px; height:20px; }
.brand-name b{ color:var(--primary); }

.nav-links{ display:flex; align-items:center; gap:34px; }
.nav-links a{
  font-family:var(--font-ui); font-size:.92rem; font-weight:500; color:var(--sub);
  position:relative; padding:4px 0; transition:color .25s ease;
}
.nav-links a::after{
  content:''; position:absolute; left:0; bottom:-2px; width:0; height:1.5px;
  background:linear-gradient(90deg, var(--primary), var(--secondary));
  transition:width .3s var(--ease-out);
}
.nav-links a:hover{ color:var(--text); }
.nav-links a:hover::after{ width:100%; }

.nav-cta{ display:flex; align-items:center; gap:14px; }
.burger{ display:none; width:26px; height:20px; position:relative; }
.burger span{ position:absolute; left:0; width:100%; height:2px; background:var(--text); border-radius:2px; transition:.3s var(--ease-out); }
.burger span:nth-child(1){ top:0; } .burger span:nth-child(2){ top:9px; } .burger span:nth-child(3){ top:18px; }
.burger.active span:nth-child(1){ transform:translateY(9px) rotate(45deg); }
.burger.active span:nth-child(2){ opacity:0; }
.burger.active span:nth-child(3){ transform:translateY(-9px) rotate(-45deg); }

.mobile-menu{
  position:fixed; top:0; right:-100%; width:min(80vw,340px); height:100vh; z-index:99;
  background:var(--bg-1); border-left:1px solid var(--glass-border);
  padding:100px 32px 32px; transition:right .4s var(--ease-out); display:flex; flex-direction:column; gap:26px;
}
.mobile-menu.open{ right:0; }
.mobile-menu a{ font-family:var(--font-ui); font-size:1.05rem; color:var(--sub); }
.mobile-menu a:hover{ color:var(--primary); }

/* ==========================================================================
   3. BUTTONS
   ========================================================================== */
.btn{
  position:relative; overflow:hidden; display:inline-flex; align-items:center; justify-content:center; gap:10px;
  font-family:var(--font-ui); font-weight:600; font-size:.92rem; letter-spacing:.2px;
  padding:15px 28px; border-radius:100px; transition: transform .35s var(--ease-out), box-shadow .35s var(--ease-out);
  white-space:nowrap;
}
.btn:active{ transform:scale(.97); }
.btn-primary{
  background:linear-gradient(135deg, var(--primary), #00c268);
  color:#03170D;
  box-shadow: 0 8px 28px -6px var(--primary-glow), inset 0 1px 0 rgba(255,255,255,.35);
}
.btn-primary:hover{ transform:translateY(-3px); box-shadow:0 14px 34px -6px var(--primary-glow), inset 0 1px 0 rgba(255,255,255,.4); }
.btn-ghost{
  background:var(--glass-bg); color:var(--text); border:1px solid var(--glass-border);
  backdrop-filter:blur(10px);
}
.btn-ghost:hover{ border-color:rgba(255,255,255,.25); transform:translateY(-3px); background:rgba(255,255,255,.07); }
.btn-sm{ padding:11px 20px; font-size:.85rem; }

.btn .ripple{
  position:absolute; border-radius:50%; background:rgba(255,255,255,.5); transform:scale(0);
  animation: rippleAnim .6s var(--ease-out); pointer-events:none;
}
@keyframes rippleAnim{ to{ transform:scale(3.2); opacity:0; } }

.btn-icon{ width:18px; height:18px; }

/* ==========================================================================
   4. GLASS / CARD PRIMITIVES
   ========================================================================== */
.glass{
  background:var(--glass-bg);
  border:1px solid var(--glass-border);
  border-radius: var(--radius-md);
  backdrop-filter: blur(18px) saturate(140%);
  -webkit-backdrop-filter: blur(18px) saturate(140%);
  position:relative;
}
.glass::before{
  content:''; position:absolute; inset:0; border-radius:inherit; padding:1px;
  background:linear-gradient(160deg, rgba(255,255,255,.18), rgba(255,255,255,0) 40%);
  -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  -webkit-mask-composite: xor; mask-composite: exclude;
  pointer-events:none;
}
.hover-card{ transition: transform .45s var(--ease-out), box-shadow .45s var(--ease-out), border-color .45s var(--ease-out); }
.hover-card:hover{
  transform: translateY(-8px);
  border-color: rgba(255,255,255,.18);
  box-shadow: 0 26px 50px -20px rgba(0,0,0,.6), 0 0 0 1px rgba(255,255,255,.03);
}

.badge{
  display:inline-flex; align-items:center; gap:8px; font-family:var(--font-ui); font-size:.78rem; font-weight:600;
  padding:8px 16px; border-radius:100px; letter-spacing:.4px; text-transform:uppercase;
  background:var(--glass-bg); border:1px solid var(--glass-border); color:var(--sub);
}
.badge .dot{ width:7px; height:7px; border-radius:50%; background:var(--primary); box-shadow:0 0 10px var(--primary); animation:pulseDot 1.6s ease-in-out infinite; }
@keyframes pulseDot{ 0%,100%{ opacity:1; } 50%{ opacity:.35; } }

.eyebrow{ color:var(--secondary); font-family:var(--font-ui); font-weight:600; font-size:.8rem; letter-spacing:2.5px; text-transform:uppercase; }

.section{ padding:120px 0; position:relative; }
.section-head{ max-width:640px; margin-bottom:64px; }
.section-head.center{ margin-left:auto; margin-right:auto; text-align:center; }
h1,h2,h3,h4{ font-family:var(--font-display); font-weight:600; line-height:1.15; }
h2{ font-size:clamp(2rem, 4vw, 3rem); margin-top:14px; }
h2 span, h1 span{ background:linear-gradient(100deg, var(--primary), var(--secondary)); -webkit-background-clip:text; background-clip:text; color:transparent; }
.section-head p{ color:var(--sub); margin-top:18px; font-size:1.05rem; }

.neon-border{
  border:1px solid transparent; border-radius:var(--radius-md);
  background: linear-gradient(var(--bg-1), var(--bg-1)) padding-box, linear-gradient(120deg, var(--primary), var(--secondary), var(--accent)) border-box;
}

/* scroll reveal */
.reveal{ opacity:0; transform:translateY(36px); transition:opacity .8s var(--ease-out), transform .8s var(--ease-out); }
.reveal.in{ opacity:1; transform:translateY(0); }

/* ==========================================================================
   5. HERO
   ========================================================================== */
.hero{ padding:180px 0 40px; position:relative; min-height:100vh; display:flex; flex-direction:column; justify-content:center; }
.hero-grid{ display:grid; grid-template-columns:1.05fr .95fr; gap:60px; align-items:center; flex-shrink:0; }
.hero-copy .badge{ margin-bottom:26px; }
.hero-copy h1{ font-size:clamp(2.6rem, 5.2vw, 4.4rem); letter-spacing:-1px; }
.hero-copy p.lead{ color:var(--sub); font-size:1.12rem; max-width:520px; margin:26px 0 38px; }
.hero-actions{ display:flex; gap:16px; flex-wrap:wrap; }

.hero-stats{ display:flex; gap:40px; margin-top:56px; flex-wrap:wrap; }
.hero-stats div b{
  display:block; font-family:var(--font-display); font-size:1.8rem; font-weight:700;
  background:linear-gradient(100deg,var(--text), var(--secondary)); -webkit-background-clip:text; background-clip:text; color:transparent;
}
.hero-stats div span{ color:var(--sub); font-size:.82rem; font-family:var(--font-ui); }

/* Trading dashboard visual */
.hero-visual{ position:relative; height:560px; }
.dash-main{
  position:absolute; inset:0; border-radius:var(--radius-lg); overflow:hidden; padding:22px;
  display:flex; flex-direction:column; gap:16px;
  box-shadow: 0 40px 90px -30px rgba(0,0,0,.7);
}
.dash-top{ display:flex; align-items:center; justify-content:space-between; }
.dash-pair{ display:flex; align-items:center; gap:10px; font-family:var(--font-ui); font-weight:600; }
.dash-pair .icon-dot{ width:10px; height:10px; border-radius:50%; background:var(--primary); box-shadow:0 0 12px var(--primary); }
.dash-price{ text-align:right; }
.dash-price b{ font-family:var(--font-display); font-size:1.3rem; color:var(--primary); }
.dash-price span{ display:block; font-size:.75rem; color:var(--sub); }

.chart-wrap{ position:relative; flex:1; border-radius:var(--radius-sm); background:rgba(255,255,255,.02); overflow:hidden; }
#candles-canvas{ width:100%; height:100%; display:block; }
.chart-line-svg{ position:absolute; inset:0; width:100%; height:100%; pointer-events:none; }

.dash-widgets{ display:grid; grid-template-columns:1fr 1fr 1fr; gap:12px; }
.mini-widget{ padding:14px; border-radius:var(--radius-sm); }
.mini-widget span{ display:block; color:var(--sub); font-size:.72rem; font-family:var(--font-ui); }
.mini-widget b{ font-family:var(--font-display); font-size:1.05rem; }
.mini-widget b.up{ color:var(--primary); } .mini-widget b.down{ color:var(--danger); }

.float-card{
  position:absolute; padding:14px 18px; border-radius:16px; display:flex; align-items:center; gap:12px;
  animation: floatY 5s var(--ease-in-out) infinite;
  box-shadow:0 20px 45px -18px rgba(0,0,0,.65);
}
.float-card.c1{ top:-6%; right:-8%; animation-delay:0s; }
.float-card.c2{ bottom:6%; left:-10%; animation-delay:-2s; }
.float-card .fc-ic{ width:34px; height:34px; border-radius:10px; display:flex; align-items:center; justify-content:center; }
.float-card .fc-ic.green{ background:rgba(0,230,118,.15); color:var(--primary); }
.float-card .fc-ic.red{ background:rgba(255,77,109,.15); color:var(--danger); }
.float-card b{ font-family:var(--font-display); font-size:.95rem; display:block; }
.float-card span{ font-size:.72rem; color:var(--sub); }
@keyframes floatY{ 0%,100%{ transform:translateY(0);} 50%{ transform:translateY(-14px);} }

.float-coin{
  position:absolute; border-radius:50%; display:flex; align-items:center; justify-content:center;
  font-family:var(--font-display); font-weight:700; font-size:.8rem; color:var(--bg-0);
  background:linear-gradient(145deg, var(--primary), var(--secondary));
  box-shadow:0 10px 26px -8px var(--primary-glow);
  animation: coinFloat 7s var(--ease-in-out) infinite;
}
@keyframes coinFloat{ 0%,100%{ transform:translateY(0) rotate(0deg);} 50%{ transform:translateY(-22px) rotate(12deg);} }

/* marquee ticker */
.ticker-strip{ border-top:1px solid var(--glass-border); border-bottom:1px solid var(--glass-border); padding:16px 0; overflow:hidden; background:rgba(255,255,255,.02); width:100%; flex-shrink:0; }
.ticker-track{ display:flex; gap:52px; width:max-content; animation:tickerScroll 32s linear infinite; }
.ticker-item{ display:flex; align-items:center; gap:8px; font-family:var(--font-ui); font-size:.88rem; color:var(--sub); white-space:nowrap; }
.ticker-item b{ color:var(--text); }
.ticker-item .up{ color:var(--primary); } .ticker-item .down{ color:var(--danger); }
@keyframes tickerScroll{ from{ transform:translateX(0);} to{ transform:translateX(-50%);} }

/* ==========================================================================
   6. STATS SECTION
   ========================================================================== */
.stats-grid{ display:grid; grid-template-columns:repeat(4,1fr); gap:24px; }
.stat-card{ padding:34px 26px; border-radius:var(--radius-md); text-align:center; }
.stat-card .icon-wrap{ width:52px; height:52px; margin:0 auto 18px; border-radius:14px; display:flex; align-items:center; justify-content:center; background:rgba(0,230,118,.1); color:var(--primary); }
.stat-card b{ display:block; font-family:var(--font-display); font-size:2.2rem; font-weight:700; }
.stat-card span{ color:var(--sub); font-family:var(--font-ui); font-size:.85rem; }

/* ==========================================================================
   7. FEATURES
   ========================================================================== */
.feature-grid{ display:grid; grid-template-columns:repeat(3,1fr); gap:26px; }
.feature-card{ padding:34px; border-radius:var(--radius-md); }
.feature-card .f-icon{
  width:54px; height:54px; border-radius:15px; display:flex; align-items:center; justify-content:center; margin-bottom:22px;
  background:linear-gradient(145deg, rgba(0,230,118,.15), rgba(0,194,255,.08)); color:var(--primary);
  border:1px solid var(--glass-border);
}
.feature-card h3{ font-size:1.15rem; margin-bottom:10px; }
.feature-card p{ color:var(--sub); font-size:.95rem; }

/* ==========================================================================
   8. ADVANTAGES (split layout)
   ========================================================================== */
.adv-grid{ display:grid; grid-template-columns:.9fr 1.1fr; gap:70px; align-items:center; }
.adv-list{ display:flex; flex-direction:column; gap:22px; margin-top:30px; }
.adv-item{ display:flex; gap:18px; padding:20px; border-radius:var(--radius-md); }
.adv-item .num{ font-family:var(--font-display); font-size:1.6rem; font-weight:700; color:var(--secondary); opacity:.5; min-width:40px; }
.adv-item h4{ font-size:1.05rem; margin-bottom:6px; }
.adv-item p{ color:var(--sub); font-size:.9rem; }

.adv-visual{ position:relative; height:480px; border-radius:var(--radius-lg); overflow:hidden; padding:26px; }
.progress-row{ margin-bottom:22px; }
.progress-row .pr-top{ display:flex; justify-content:space-between; font-family:var(--font-ui); font-size:.85rem; margin-bottom:8px; color:var(--sub); }
.progress-track{ height:8px; border-radius:10px; background:rgba(255,255,255,.06); overflow:hidden; }
.progress-fill{ height:100%; border-radius:10px; background:linear-gradient(90deg, var(--primary), var(--secondary)); width:0; transition:width 1.4s var(--ease-out); box-shadow:0 0 14px var(--primary-glow); }

/* ==========================================================================
   9. MARKET ANALYSIS (SVG chart)
   ========================================================================== */
.market-panel{ padding:30px; border-radius:var(--radius-lg); }
.market-tabs{ display:flex; gap:10px; margin-bottom:24px; flex-wrap:wrap; }
.m-tab{ padding:10px 18px; border-radius:100px; font-family:var(--font-ui); font-size:.82rem; font-weight:600; color:var(--sub); border:1px solid var(--glass-border); transition:.3s; }
.m-tab.active, .m-tab:hover{ color:var(--bg-0); background:linear-gradient(135deg,var(--primary),var(--secondary)); border-color:transparent; }
.market-chart{ height:340px; position:relative; border-radius:var(--radius-sm); background:rgba(255,255,255,.02); }
#analysis-svg{ width:100%; height:100%; }
.chart-path{ fill:none; stroke:var(--primary); stroke-width:2.4; stroke-linecap:round; filter: drop-shadow(0 0 6px var(--primary-glow)); }
.chart-area{ opacity:.18; }
.chart-dot{ fill:var(--bg-0); stroke:var(--primary); stroke-width:2.4; }

/* ==========================================================================
   10. PERFORMANCE CARDS
   ========================================================================== */
.perf-grid{ display:grid; grid-template-columns:repeat(3,1fr); gap:24px; }
.perf-card{ padding:30px; border-radius:var(--radius-md); position:relative; overflow:hidden; }
.perf-card .p-head{ display:flex; justify-content:space-between; align-items:center; margin-bottom:18px; }
.perf-card h3{ font-size:1.05rem; }
.perf-card .tag{ font-size:.7rem; font-family:var(--font-ui); font-weight:700; padding:5px 12px; border-radius:100px; text-transform:uppercase; }
.tag.win{ background:rgba(0,230,118,.15); color:var(--primary); }
.perf-mini-chart{ height:70px; margin:14px 0; }
.perf-card .p-foot{ display:flex; justify-content:space-between; font-family:var(--font-ui); font-size:.82rem; color:var(--sub); }
.perf-card .p-foot b{ color:var(--text); font-size:1.05rem; display:block; font-family:var(--font-display); }

/* ==========================================================================
   11. TIMELINE / HOW IT WORKS
   ========================================================================== */
.timeline{ position:relative; max-width:900px; margin:0 auto; }
.timeline::before{
  content:''; position:absolute; left:29px; top:10px; bottom:10px; width:2px;
  background:linear-gradient(var(--primary), var(--secondary), var(--accent)); opacity:.4;
}
.tl-item{ display:flex; gap:28px; padding-bottom:52px; position:relative; }
.tl-item:last-child{ padding-bottom:0; }
.tl-dot{
  min-width:60px; height:60px; border-radius:50%; display:flex; align-items:center; justify-content:center;
  font-family:var(--font-display); font-weight:700; font-size:1.2rem; z-index:1;
  background:var(--bg-1); border:1px solid var(--glass-border);
}
.tl-item.active .tl-dot{ background:linear-gradient(135deg,var(--primary),var(--secondary)); color:var(--bg-0); box-shadow:0 0 22px var(--primary-glow); }
.tl-content{ padding-top:8px; }
